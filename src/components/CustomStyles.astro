---
import '@fontsource-variable/inter';
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+SC:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
  rel="stylesheet"
/>

<style is:inline>
  :root {
    /* 字体栈:Inter (拉丁) + Noto Sans SC (中文) + JetBrains Mono (代码) */
    --aw-font-sans:
      'Inter', 'Noto Sans SC', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB',
      'Microsoft YaHei', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji';
    --aw-font-serif: 'Inter', 'Noto Sans SC', ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif;
    --aw-font-heading:
      'Inter', 'Noto Sans SC', ui-sans-serif, system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    --aw-font-mono:
      'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Source Code Pro', Menlo, Monaco, Consolas, monospace;

    /* Agent KG Hub 主题色板:深蓝/靛青 */
    --aw-color-primary: rgb(79 70 229); /* Indigo-600 #4F46E5 */
    --aw-color-secondary: rgb(67 56 202); /* Indigo-700 #4338CA */
    --aw-color-accent: rgb(14 165 233); /* Sky-500 #0EA5E9 */

    --aw-color-text-heading: rgb(17 24 39); /* slate-900 */
    --aw-color-text-default: rgb(30 41 59); /* slate-800 */
    --aw-color-text-muted: rgb(71 85 105 / 75%); /* slate-600/75 */
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(8 11 26);

    /* 字体渲染优化 */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;

    ::selection {
      background-color: rgb(199 210 254); /* indigo-200 */
    }
  }

  .dark {
    --aw-font-sans:
      'Inter', 'Noto Sans SC', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB',
      'Microsoft YaHei', sans-serif;
    --aw-font-serif: 'Inter', 'Noto Sans SC', ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif;
    --aw-font-heading:
      'Inter', 'Noto Sans SC', ui-sans-serif, system-ui, -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    --aw-font-mono:
      'JetBrains Mono', 'Fira Code', 'Cascadia Code', 'Source Code Pro', Menlo, Monaco, Consolas, monospace;

    --aw-color-primary: rgb(129 140 248); /* Indigo-400 (深色模式提亮) */
    --aw-color-secondary: rgb(165 180 252); /* Indigo-300 */
    --aw-color-accent: rgb(56 189 248); /* Sky-400 */

    --aw-color-text-heading: rgb(248 250 252); /* slate-50 */
    --aw-color-text-default: rgb(226 232 240); /* slate-200 */
    --aw-color-text-muted: rgb(148 163 184 / 80%); /* slate-400/80 */
    --aw-color-bg-page: rgb(8 11 26);

    ::selection {
      background-color: rgb(67 56 202); /* indigo-700 */
      color: rgb(238 242 255); /* indigo-50 */
    }
  }

  /* 标题字重与字距优化 */
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--aw-font-heading);
    font-feature-settings:
      'kern' 1,
      'liga' 1;
  }

  /* 中英文混排优化 */
  :lang(zh) {
    word-break: break-word;
  }

  /* 长代码块横向滚动 */
  pre {
    overflow-x: auto;
    font-family: var(--aw-font-mono);
  }
</style>

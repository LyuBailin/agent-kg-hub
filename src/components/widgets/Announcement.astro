---
// 顶部公告条 — 显示项目状态与 GitHub 链接
// 文案根据当前 locale 自动从 ~/navigation 注入
export interface Props {
  badge?: string;
  message?: string;
}

const { badge = 'NEW', message = 'Agent KG Hub v0.1.0 — welcome contributions' } = Astro.props;
---

<div
  class="text-sm bg-slate-900 text-slate-300 dark:bg-transparent dark:border-b dark:border-slate-800 dark:text-slate-400 hidden md:flex gap-1 overflow-hidden px-3 py-2 relative text-ellipsis whitespace-nowrap"
>
  <span
    class="bg-white/20 dark:bg-slate-700 text-slate-100 dark:text-slate-300 font-semibold px-1 py-0.5 text-xs mr-0.5 rtl:mr-0 rtl:ml-0.5 inline-block"
    >{badge}</span
  >
  <a
    href="https://github.com/LyuBailin/agent-kg-hub"
    class="text-slate-300 hover:underline dark:text-slate-400 font-medium">{message}</a
  >
  <a
    target="_blank"
    rel="noopener"
    class="ltr:ml-auto rtl:mr-auto inline-flex items-center gap-1 text-slate-300 hover:underline dark:text-slate-400"
    title="View on GitHub"
    href="https://github.com/LyuBailin/agent-kg-hub"
  >
    <span class="text-xs">★ Star</span>
  </a>
</div>

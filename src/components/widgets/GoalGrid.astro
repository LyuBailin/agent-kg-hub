---
/**
 * GoalGrid — 首页"问题驱动"目标导航卡片网格 (W10 首页大改版)
 *
 * 设计目的:让用户进入首页后,能直接通过"我想做 X"的问题找到对应入口,
 * 而不是按资源类型(论文/项目/教程)浏览。
 *
 * 数据驱动:所有文案作为 props 传入,中英文版共用 widget,只传不同 goals 数组。
 */

import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

export type GoalColor = 'indigo' | 'sky' | 'violet' | 'emerald' | 'amber' | 'rose';

export interface Goal {
  /** Tabler icon 名,例如 'tabler:graph' */
  icon: string;
  /** 卡片标题(以"我想..."开头,符合问题驱动语境) */
  title: string;
  /** 1-2 句简短说明 */
  description: string;
  /** 关联的 1-3 个标签,作为视觉 cue(不链) */
  tags: string[];
  /** 卡片点击跳转的目标文章 URL */
  href: string;
  /** CTA 文字,如"查看方案" / "See the path" */
  cta: string;
  /** 卡片主色(决定 icon 圆 / tag pill / CTA 文字色) */
  color: GoalColor;
}

export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  goals: Goal[];
  id?: string;
  isDark?: boolean;
  classes?: { container?: string };
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  goals = [],
  id = 'goals',
  isDark = false,
  classes = {},
} = Astro.props;

const colorMap: Record<GoalColor, { ring: string; icon: string; tag: string; cta: string }> = {
  indigo: {
    ring: 'ring-indigo-200 dark:ring-indigo-800/50 hover:ring-indigo-400 dark:hover:ring-indigo-600',
    icon: 'bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-300',
    tag: 'bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-200',
    cta: 'text-indigo-600 dark:text-indigo-300 group-hover:text-indigo-700 dark:group-hover:text-indigo-200',
  },
  sky: {
    ring: 'ring-sky-200 dark:ring-sky-800/50 hover:ring-sky-400 dark:hover:ring-sky-600',
    icon: 'bg-sky-100 dark:bg-sky-900/40 text-sky-600 dark:text-sky-300',
    tag: 'bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-200',
    cta: 'text-sky-600 dark:text-sky-300 group-hover:text-sky-700 dark:group-hover:text-sky-200',
  },
  violet: {
    ring: 'ring-violet-200 dark:ring-violet-800/50 hover:ring-violet-400 dark:hover:ring-violet-600',
    icon: 'bg-violet-100 dark:bg-violet-900/40 text-violet-600 dark:text-violet-300',
    tag: 'bg-violet-50 dark:bg-violet-900/30 text-violet-700 dark:text-violet-200',
    cta: 'text-violet-600 dark:text-violet-300 group-hover:text-violet-700 dark:group-hover:text-violet-200',
  },
  emerald: {
    ring: 'ring-emerald-200 dark:ring-emerald-800/50 hover:ring-emerald-400 dark:hover:ring-emerald-600',
    icon: 'bg-emerald-100 dark:bg-emerald-900/40 text-emerald-600 dark:text-emerald-300',
    tag: 'bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-200',
    cta: 'text-emerald-600 dark:text-emerald-300 group-hover:text-emerald-700 dark:group-hover:text-emerald-200',
  },
  amber: {
    ring: 'ring-amber-200 dark:ring-amber-800/50 hover:ring-amber-400 dark:hover:ring-amber-600',
    icon: 'bg-amber-100 dark:bg-amber-900/40 text-amber-600 dark:text-amber-300',
    tag: 'bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-200',
    cta: 'text-amber-600 dark:text-amber-300 group-hover:text-amber-700 dark:group-hover:text-amber-200',
  },
  rose: {
    ring: 'ring-rose-200 dark:ring-rose-800/50 hover:ring-rose-400 dark:hover:ring-rose-600',
    icon: 'bg-rose-100 dark:bg-rose-900/40 text-rose-600 dark:text-rose-300',
    tag: 'bg-rose-50 dark:bg-rose-900/30 text-rose-700 dark:text-rose-200',
    cta: 'text-rose-600 dark:text-rose-300 group-hover:text-rose-700 dark:group-hover:text-rose-200',
  },
};
---

<WidgetWrapper id={id} isDark={isDark} containerClass={twMerge('max-w-7xl mx-auto', classes?.container)}>
  {
    (title || subtitle || tagline) && (
      <div class="text-center mb-10 md:mb-14 max-w-3xl mx-auto">
        {tagline && (
          <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase" set:html={tagline} />
        )}
        {title && <h2 class="text-4xl md:text-5xl font-bold tracking-tighter mb-4 font-heading" set:html={title} />}
        {subtitle && <p class="text-xl text-muted dark:text-slate-400" set:html={subtitle} />}
      </div>
    )
  }

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      goals.map((goal) => {
        const c = colorMap[goal.color];
        return (
          <a
            href={goal.href}
            class:list={[
              'group relative flex flex-col p-6 rounded-xl bg-white dark:bg-slate-800/50 ring-1 transition-all duration-200',
              'hover:shadow-lg hover:-translate-y-1',
              c.ring,
            ]}
          >
            <div class:list={['inline-flex h-12 w-12 items-center justify-center rounded-lg mb-4', c.icon]}>
              <Icon name={goal.icon} class="w-6 h-6" />
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2 font-heading">{goal.title}</h3>
            <p class="text-base text-muted dark:text-slate-400 mb-4 flex-grow">{goal.description}</p>
            <div class="flex flex-wrap gap-2 mb-5">
              {goal.tags.map((tag) => (
                <span class:list={['px-2.5 py-0.5 text-xs font-medium rounded-full', c.tag]}>{tag}</span>
              ))}
            </div>
            <div class:list={['inline-flex items-center text-sm font-semibold', c.cta]}>
              <span>{goal.cta}</span>
              <Icon name="tabler:arrow-right" class="w-4 h-4 ml-1 transition-transform group-hover:translate-x-1" />
            </div>
          </a>
        );
      })
    }
  </div>
</WidgetWrapper>

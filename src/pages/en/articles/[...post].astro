---
import merge from 'lodash.merge';
import type { ImageMetadata } from 'astro';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

import Layout from '~/layouts/PageLayout.astro';
import SinglePost from '~/components/blog/SinglePost.astro';
import ToBlogLink from '~/components/blog/ToBlogLink.astro';
import RelatedPosts from '~/components/blog/RelatedPosts.astro';

import { getCanonical, getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import type { MetaData, Post } from '~/types';

/** Shape returned by the lazy `import.meta.glob` for a single post .md file. */
interface EnPostModuleData {
  frontmatter: {
    title: string;
    excerpt?: string;
    publishDate?: string;
    updateDate?: string;
    image?: string;
    category?: string;
    tags?: string[];
    author?: string;
  };
  Content: AstroComponentFactory;
}

export async function getStaticPaths() {
  // 每次调用 getStaticPaths 都重新执行 import.meta.glob
  const postModules = import.meta.glob<EnPostModuleData>('../../../data/post-en/*.md');
  return Object.keys(postModules).map((path) => {
    const slug = path.split('/').pop()!.replace('.md', '');
    return {
      params: { post: slug },
      props: { slug },
    };
  });
}

const { slug } = Astro.props;

// 再次获取(因为 props 里的 slug 是关键,modules 在 Astro 渲染时需要)
const postModules = import.meta.glob<EnPostModuleData>('../../../data/post-en/*.md');
const moduleKey = `../../../data/post-en/${slug}.md`;
const postLoader = postModules[moduleKey];

if (!postLoader) {
  throw new Error(`Post not found: ${slug}`);
}

const { frontmatter, Content } = await postLoader();

const permalink = `/en/articles/${slug}/`;
const url = getCanonical(getPermalink(permalink));
const image = (await findImage(frontmatter.image)) as ImageMetadata | string | undefined;

// Only string URLs (external/public) can flow into MetaDataOpenGraph.images.url.
// Local ImageMetadata goes through the adaptOpenGraphImages helper at Metadata.astro time.
const imageUrl = typeof image === 'string' ? image : '';

const metadata: MetaData = merge(
  {
    title: frontmatter.title,
    description: frontmatter.excerpt,
    robots: { index: true, follow: true },
    openGraph: {
      type: 'article',
      ...(imageUrl
        ? {
            images: [
              {
                url: imageUrl,
                width: (image as ImageMetadata)?.width ?? 1200,
                height: (image as ImageMetadata)?.height ?? 626,
              },
            ],
          }
        : {}),
    },
  },
  {}
);

const shapedPost: Post = {
  id: slug,
  slug: slug,
  permalink,
  title: frontmatter.title,
  excerpt: frontmatter.excerpt || '',
  publishDate: new Date(frontmatter.publishDate ?? 0),
  updateDate: frontmatter.updateDate ? new Date(frontmatter.updateDate) : undefined,
  image: frontmatter.image,
  category: frontmatter.category ? { slug: frontmatter.category, title: frontmatter.category } : undefined,
  tags: (frontmatter.tags || []).map((t) => ({ slug: t, title: t })),
  author: frontmatter.author || 'LyuBailin',
  Content,
};
---

<Layout metadata={metadata}>
  <SinglePost post={shapedPost} url={url}>
    <Content />
  </SinglePost>
  <ToBlogLink />
  <RelatedPosts post={shapedPost} />
</Layout>

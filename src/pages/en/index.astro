---
import Layout from '~/layouts/PageLayout.astro';
import GoalGrid from '~/components/widgets/GoalGrid.astro';
import type { Goal } from '~/components/widgets/GoalGrid.astro';

import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ParadigmMap from '~/components/widgets/ParadigmMap.astro';

const metadata = {
  title: 'Agent × Knowledge Graph Resource Hub',
  description:
    'A focused resource hub for LLM Agent and Knowledge Graph intersection - covering GraphRAG, Graph-Augmented LLM Agents, and the three major fusion paradigms.',
};

// Homepage "problem-driven" goal cards (W10 redesign + W16 add learning path)
// Each card maps to a concrete concept article that already exists, or to the learning paths index.
const goals: Goal[] = [
  {
    icon: 'tabler:walk',
    title: 'I want a 0→1 learning path',
    description:
      'Four curated reading paths (intro / GraphRAG / Agent capabilities / KG deep-dive) — read in order over 2-6 hours and you’re hands-on.',
    tags: ['Learning Path', 'Systematic', 'Intro'],
    href: '/agent-kg-hub/en/learning-path/',
    cta: 'See the path',
    color: 'rose',
  },
  {
    icon: 'tabler:graph',
    title: 'I want to enhance RAG with a KG',
    description:
      'Start from the pain points of traditional RAG, understand why you need a graph, and learn how the Local / Global / DRIFT / Lazy retrieval modes work.',
    tags: ['GraphRAG', 'RAG', 'Microsoft'],
    href: '/agent-kg-hub/en/articles/concept-graphrag-intro/',
    cta: 'See the path',
    color: 'indigo',
  },
  {
    icon: 'tabler:chart-bar',
    title: 'I want to evaluate an Agent',
    description:
      'End-to-end benchmarks vs. trajectory evaluation, key metrics, and how to use AgentBench / SWE-bench / GAIA in practice.',
    tags: ['Agent', 'Evaluation', 'Benchmark'],
    href: '/agent-kg-hub/en/articles/concept-agent-evaluation/',
    cta: 'See the path',
    color: 'sky',
  },
  {
    icon: 'tabler:brain',
    title: 'I want to give an Agent long-term memory',
    description:
      'How short-term / long-term / episodic / procedural memory work together, and landmark systems like MemGPT, MemoryBank, and Mem0.',
    tags: ['Agent', 'Memory', 'MemGPT'],
    href: '/agent-kg-hub/en/articles/concept-agent-memory/',
    cta: 'See the path',
    color: 'violet',
  },
  {
    icon: 'tabler:route',
    title: 'I want LLM to learn "querying a KG"',
    description:
      'Treat the KG as a structured anchor for LLM reasoning — train the model with RL / CoT to actively query, cite, and verify KG knowledge.',
    tags: ['KG', 'Reasoning', 'KG-R1'],
    href: '/agent-kg-hub/en/articles/concept-kg-reasoning/',
    cta: 'See the path',
    color: 'emerald',
  },
  {
    icon: 'tabler:robot',
    title: 'I want to build an Agent from scratch',
    description:
      'The underlying loop of nearly every modern Agent framework — ReAct unifies "reasoning" and "acting" into a single LLM cycle.',
    tags: ['ReAct', 'Agent', 'Prompt'],
    href: '/agent-kg-hub/en/articles/concept-react-intro/',
    cta: 'See the path',
    color: 'amber',
  },
  {
    icon: 'tabler:share-3',
    title: 'I want the full picture of GLA',
    description:
      'The 2025 IEEE survey formally defines Graph-Augmented LLM Agents — unifying the four dimensions of planning / memory / tools / collaboration as a graph.',
    tags: ['GLA', 'Graph Agent', 'Survey'],
    href: '/agent-kg-hub/en/articles/concept-graph-augmented-agents/',
    cta: 'See the path',
    color: 'rose',
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Browse by Goal',
        href: '/agent-kg-hub/en/#goals',
        icon: 'tabler:target',
      },
      {
        text: 'Browse Resources',
        href: '/agent-kg-hub/en/category/',
        icon: 'tabler:compass',
      },
      {
        text: 'Search',
        href: '/agent-kg-hub/en/search',
        icon: 'tabler:search',
      },
      {
        text: '中文',
        href: '/agent-kg-hub/',
        icon: 'tabler:language',
      },
    ]}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">LLM Agent</span>
      ×
      <span class="text-accent dark:text-white">Knowledge Graph</span>
      <br />Resource Hub & Deep Dives
    </Fragment>

    <Fragment slot="subtitle">
      A focused resource aggregation + concept deep-dives for the
      <span class="font-semibold">Agent × KG intersection</span>. Not sure where to start? <span
        class="font-semibold text-accent dark:text-white">Pick a goal</span
      > and we'll take you straight to the right entry point.
    </Fragment>

    <Fragment slot="bg">
      <svg
        class="absolute inset-0 w-full h-full opacity-[0.07] dark:opacity-[0.12]"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid slice"
        viewBox="0 0 1200 600"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="hero-line-en" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#4F46E5"></stop>
            <stop offset="50%" stop-color="#0EA5E9"></stop>
            <stop offset="100%" stop-color="#8B5CF6"></stop>
          </linearGradient>
        </defs>
        <g fill="url(#hero-line-en)">
          <circle cx="100" cy="80" r="4"></circle>
          <circle cx="350" cy="100" r="5"></circle>
          <circle cx="600" cy="120" r="4"></circle>
          <circle cx="850" cy="140" r="5"></circle>
          <circle cx="1100" cy="160" r="4"></circle>
          <circle cx="150" cy="350" r="5"></circle>
          <circle cx="400" cy="380" r="4"></circle>
          <circle cx="650" cy="400" r="5"></circle>
          <circle cx="900" cy="420" r="4"></circle>
          <circle cx="180" cy="520" r="4"></circle>
          <circle cx="460" cy="540" r="5"></circle>
          <circle cx="750" cy="520" r="4"></circle>
        </g>
        <g stroke="url(#hero-line-en)" stroke-width="1" opacity="0.6">
          <line x1="100" y1="80" x2="350" y2="100"></line>
          <line x1="350" y1="100" x2="600" y2="120"></line>
          <line x1="600" y1="120" x2="850" y2="140"></line>
          <line x1="850" y1="140" x2="1100" y2="160"></line>
          <line x1="150" y1="350" x2="400" y2="380"></line>
          <line x1="400" y1="380" x2="650" y2="400"></line>
          <line x1="650" y1="400" x2="900" y2="420"></line>
          <line x1="100" y1="80" x2="150" y2="350"></line>
          <line x1="350" y1="100" x2="400" y2="380"></line>
          <line x1="600" y1="120" x2="650" y2="400"></line>
          <line x1="850" y1="140" x2="900" y2="420"></line>
        </g>
      </svg>
    </Fragment>
  </Hero>

  <!-- GoalGrid: problem-driven navigation (W10 new) -->

  <GoalGrid
    tagline="Browse by goal"
    title="What do you want to do?"
    subtitle="Seven of the most common Agent × KG scenarios — each card links straight to a deep-dive article or learning path."
    goals={goals}
  />

  <ParadigmMap locale="en" />

  <Content
    isReversed
    tagline="Tracking"
    title="Projects We Track"
    items={[
      {
        title: 'Microsoft GraphRAG',
        description:
          'Industrial-grade KG-enhanced RAG, open-sourced July 2024, four retrieval modes: Local/Global/DRIFT/Lazy.',
      },
      {
        title: 'LangGraph (80k+ stars, MIT)',
        description:
          'State-machine modeling of agents via directed graphs, with Human-in-the-Loop and Checkpoint support.',
      },
      {
        title: 'HuggingFace smolagents',
        description: 'Minimal Code Agent implementation (~1k lines of core code) - LLM generates Python directly.',
      },
      {
        title: 'ByteDance DeerFlow 2.0',
        description: 'Long-horizon SuperAgent with sub-agent orchestration, sandbox isolation, long-term memory.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1518770660439-4636190af475?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: 'Knowledge Graph and Agent network',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Not just a list — a project map
      </h3>
      Categorized with original commentary, helping you decide which projects deserve deep investigation.
    </Fragment>
  </Content>

  <BlogLatestPosts
    title="Latest Deep Dives"
    information="Continuously updated. Starting with 1-2 deep articles per fusion paradigm, then covering specific projects and case studies."
  />

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Recommend Resource / Contribute',
        href: 'https://github.com/LyuBailin/agent-kg-hub/issues',
        target: '_blank',
        icon: 'tabler:message-plus',
      },
      {
        text: 'View on GitHub',
        href: 'https://github.com/LyuBailin/agent-kg-hub',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]}
  >
    <Fragment slot="title">Help us make this better</Fragment>

    <Fragment slot="subtitle">
      Welcome to recommend resources, contribute articles, and report issues. Building the Agent × KG community
      together.
    </Fragment>
  </CallToAction>
</Layout>

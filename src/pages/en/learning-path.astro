---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import { Icon } from 'astro-icon/components';

import { fetchEnPosts } from '~/utils/posts-en';

export const prerender = true;

// 4 learning paths · 3-5 articles each · covering all 17 English articles, no duplicates
const paths = [
  {
    id: 'getting-started',
    icon: 'tabler:rocket',
    name: 'Zero-to-One Onboarding',
    badge: 'Recommended start',
    description: 'Start with the core concepts of Agent and KG. 2-3 hours of reading and you can follow every other path on this site.',
    target: 'Developers new to the Agent × KG intersection',
    color: 'indigo',
    articles: [
      { slug: 'concept-react-intro', note: 'The ReAct paradigm — how an LLM Agent interleaves reasoning and action.' },
      { slug: 'concept-graphrag-intro', note: 'GraphRAG onboarding — the canonical KG-enhanced RAG approach.' },
      { slug: 'resource-hello-agents', note: 'The best Chinese-language Agent tutorial (~20-30K words, with code).' },
    ],
  },
  {
    id: 'graphrag-engineering',
    icon: 'tabler:graph',
    name: 'GraphRAG in Production',
    badge: 'Engineer track',
    description: 'From the principles to three reference projects, complete a full GraphRAG selection and hands-on.',
    target: 'Backend / application engineers adopting GraphRAG in production',
    color: 'sky',
    articles: [
      { slug: 'resource-microsoft-graphrag', note: 'Industrial-grade de facto standard, with Local/Global/DRIFT/Lazy retrieval modes.' },
      { slug: 'resource-lightrag', note: 'Lightweight open-source option, ~10x lower indexing cost, 40k+ stars.' },
      { slug: 'resource-llm-graph-builder', note: 'No-code tool: push a PDF into Neo4j in 5 minutes.' },
      { slug: 'resource-graphrag-survey-peng', note: '2024 survey systematizing the G-Indexing / G-Retrieval / G-Generation pipeline.' },
    ],
  },
  {
    id: 'agent-capability',
    icon: 'tabler:brain',
    name: 'Building Capable Agents',
    badge: 'App developer',
    description: 'From memory mechanisms to engineering, give your Agent long-term memory, state machines, and evaluation.',
    target: 'Application developers making Agents actually useful',
    color: 'violet',
    articles: [
      { slug: 'concept-agent-memory', note: 'Four memory mechanisms — short-term, long-term, episodic, procedural.' },
      { slug: 'resource-cognee', note: 'Long-term memory for Agents in 6 lines of Python.' },
      { slug: 'resource-langgraph', note: 'Directed-graph framework for Agent state machines.' },
      { slug: 'resource-smolagents', note: 'Minimal Code Agent paradigm reference (~1k lines of core code).' },
      { slug: 'concept-agent-evaluation', note: 'Evaluation methodology — AgentBench / SWE-bench / GAIA.' },
    ],
  },
  {
    id: 'kg-augmented-deep',
    icon: 'tabler:route',
    name: 'KG-Augmented LLMs In Depth',
    badge: 'Research direction',
    description: 'From the academic coordinate to concrete methods, understand "graph" as a unified abstraction for Agent systems.',
    target: 'Researchers and engineers going deep',
    color: 'emerald',
    articles: [
      { slug: 'concept-graph-augmented-agents', note: 'GLA (Graph-Augmented LLM Agents) survey — the three fusion paradigms.' },
      { slug: 'concept-kg-reasoning', note: 'KG-enhanced reasoning — RL / CoT for LLMs to actively query KG (KG-R1, ToG).' },
      { slug: 'resource-qa-gnn', note: 'Classic work feeding KG reasoning paths to LLMs (ACL 2021).' },
      { slug: 'concept-kg-quality', note: 'KG quality assessment — completeness, accuracy, consistency.' },
      { slug: 'resource-graphrag-survey', note: 'IEEE survey — the academic coordinate for graph agents.' },
    ],
  },
];

// Validate all articles exist in the English collection, fail build if not
const enPosts = fetchEnPosts();
const postMap = new Map(enPosts.map((p) => [p.slug, p]));

const allSlugs = paths.flatMap((p) => p.articles.map((a) => a.slug));
for (const slug of allSlugs) {
  if (!postMap.has(slug)) {
    throw new Error(`[en/learning-path.astro] post "${slug}" not found in src/data/post-en/; build aborted`);
  }
}

// Merge real title / permalink / category / reading time
for (const path of paths) {
  for (const article of path.articles) {
    const post = postMap.get(article.slug)!;
    article.title = post.title;
    article.category = post.category?.title || '';
    article.permalink = post.permalink; // already includes /en/articles/<slug>/
  }
}

// Static color map to avoid Tailwind dynamic-class purging
const COLORS: Record<string, { iconBg: string; iconText: string; ring: string; badge: string; step: string; link: string }> = {
  indigo: {
    iconBg: 'bg-indigo-100 dark:bg-indigo-900/40',
    iconText: 'text-indigo-600 dark:text-indigo-300',
    ring: 'ring-indigo-200 dark:ring-indigo-800/50 dark:hover:ring-indigo-600 hover:ring-indigo-400',
    badge: 'bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-200',
    step: 'bg-indigo-500',
    link: 'text-indigo-600 dark:text-indigo-300 hover:text-indigo-700 dark:hover:text-indigo-200',
  },
  sky: {
    iconBg: 'bg-sky-100 dark:bg-sky-900/40',
    iconText: 'text-sky-600 dark:text-sky-300',
    ring: 'ring-sky-200 dark:ring-sky-800/50 dark:hover:ring-sky-600 hover:ring-sky-400',
    badge: 'bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-200',
    step: 'bg-sky-500',
    link: 'text-sky-600 dark:text-sky-300 hover:text-sky-700 dark:hover:text-sky-200',
  },
  violet: {
    iconBg: 'bg-violet-100 dark:bg-violet-900/40',
    iconText: 'text-violet-600 dark:text-violet-300',
    ring: 'ring-violet-200 dark:ring-violet-800/50 dark:hover:ring-violet-600 hover:ring-violet-400',
    badge: 'bg-violet-50 dark:bg-violet-900/30 text-violet-700 dark:text-violet-200',
    step: 'bg-violet-500',
    link: 'text-violet-600 dark:text-violet-300 hover:text-violet-700 dark:hover:text-violet-200',
  },
  emerald: {
    iconBg: 'bg-emerald-100 dark:bg-emerald-900/40',
    iconText: 'text-emerald-600 dark:text-emerald-300',
    ring: 'ring-emerald-200 dark:ring-emerald-800/50 dark:hover:ring-emerald-600 hover:ring-emerald-400',
    badge: 'bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-200',
    step: 'bg-emerald-500',
    link: 'text-emerald-600 dark:text-emerald-300 hover:text-emerald-700 dark:hover:text-emerald-200',
  },
};

const totalArticles = paths.reduce((sum, p) => sum + p.articles.length, 0);

const metadata = {
  title: 'Learning Paths',
  description: 'Zero-to-one learning routes: 4 paths linking 17 articles. Pick one for your goal and go from zero to hands-on in 2-6 hours.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero tagline="Learning paths">
    <Fragment slot="title">
      0 → 1 <span class="text-accent dark:text-white">Agent × KG</span> learning routes
    </Fragment>
    <Fragment slot="subtitle">
      Four curated reading paths linking {totalArticles} articles. Pick the one that matches your goal — go from zero to hands-on in 2-6 hours.
    </Fragment>
  </Hero>

  <Note
    title="How to pick?"
    description="New here → start with <strong>Zero-to-One Onboarding</strong>. Have a concrete engineering goal → jump straight to the matching path. Doing research or going deep → <strong>KG-Augmented LLMs In Depth</strong>. Read each path in order, ~5-15 min per article."
  />

  <section class="px-4 sm:px-6 xl:px-8 mx-auto max-w-7xl py-8 lg:py-16">
    <div class="grid gap-8 lg:grid-cols-2">
      {
        paths.map((path) => {
          const c = COLORS[path.color];
          return (
            <article
              class:list={[
                'flex flex-col bg-white dark:bg-slate-800/50 rounded-xl p-6 lg:p-7 ring-1 transition-shadow hover:shadow-lg',
                c.ring,
              ]}
            >
              <div class="flex items-start justify-between mb-4 gap-3">
                <div class="flex items-center min-w-0">
                  <div class:list={['flex items-center justify-center h-12 w-12 rounded-lg flex-shrink-0', c.iconBg, c.iconText]}>
                    <Icon name={path.icon} class="w-6 h-6" />
                  </div>
                  <h2 class="ml-3 text-xl lg:text-2xl font-bold font-heading dark:text-white text-slate-900 truncate">
                    {path.name}
                  </h2>
                </div>
                <span class:list={['text-xs font-medium px-2.5 py-1 rounded-full whitespace-nowrap flex-shrink-0', c.badge]}>
                  {path.badge}
                </span>
              </div>

              <p class="text-base text-slate-600 dark:text-slate-300 mb-3 leading-relaxed">
                {path.description}
              </p>

              <div class="text-sm text-slate-500 dark:text-slate-400 mb-5">
                <span class="font-semibold text-slate-700 dark:text-slate-300">For:</span>
                {path.target}
              </div>

              <div class="mb-5">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">
                  Reading order · {path.articles.length} step{path.articles.length > 1 ? 's' : ''}
                </h3>
                <ol class="space-y-3">
                  {path.articles.map((article, i) => (
                    <li class="flex">
                      <div class:list={['flex-shrink-0 w-7 h-7 rounded-full text-white font-bold text-sm flex items-center justify-center mr-3 mt-0.5', c.step]}>
                        {i + 1}
                      </div>
                      <div class="flex-1 min-w-0">
                        <a
                          href={article.permalink}
                          class="font-semibold text-base text-slate-900 dark:text-white hover:text-primary dark:hover:text-primary transition"
                        >
                          {article.title}
                        </a>
                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5 leading-relaxed">
                          {article.note}
                        </p>
                        <div class="flex flex-wrap items-center gap-2 mt-1.5 text-xs text-slate-400 dark:text-slate-500">
                          <span class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-700/60 rounded">
                            {article.category}
                          </span>
                        </div>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>

              <div class="mt-auto pt-4 border-t border-slate-200 dark:border-slate-700 flex items-center justify-between">
                <a
                  href={path.articles[0].permalink}
                  class:list={['inline-flex items-center font-semibold transition', c.link]}
                >
                  Start this path
                  <Icon name="tabler:arrow-right" class="w-4 h-4 ml-1" />
                </a>
                <span class="text-xs text-slate-400 dark:text-slate-500">
                  ~{path.articles.length * 8} min
                </span>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <Note
    title="Want a custom path?"
    description={`Browse by <a class="text-primary underline" href="/en/tag/">tag</a> or <a class="text-primary underline" href="/en/category/">category</a> to assemble your own sequence, or jump from the <a class="text-primary underline" href="/agent-kg-hub/">homepage goal grid</a> to the article you need.`}
  />
</Layout>

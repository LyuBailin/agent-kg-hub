---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Search',
  description: 'Search all content on Agent KG Hub - resource navigation, concept deep-dives, technical articles',
  robots: { index: false, follow: true },
};
---

<Layout metadata={metadata}>
  <section class="px-4 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <div class="text-center mb-8">
      <h1
        class="font-bold font-heading leading-tighter tracking-tighter text-heading text-4xl md:text-5xl mb-4"
      >
        <span class="inline-block align-middle">
          <Icon name="tabler:search" class="w-10 h-10 inline-block mr-2 text-primary" />
        </span>
        Search
      </h1>
      <p class="text-muted text-lg">Search all resources, deep-dives, and articles on this site</p>
    </div>

    <div id="search" class="mx-auto">
      <div class="mb-6">
        <input
          type="search"
          id="search-input"
          placeholder="Enter keywords, e.g.: GraphRAG, smolagents, KG completion..."
          class="w-full px-5 py-4 text-lg border-2 border-slate-200 dark:border-slate-700 rounded-lg bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition"
          autocomplete="off"
        />
      </div>

      <div id="search-status" class="text-sm text-muted mb-4 hidden"></div>
      <div id="search-results" class="space-y-4"></div>

      <noscript>
        <p class="text-muted text-center py-8">
          Search requires JavaScript. Please enable JS and try again.
        </p>
      </noscript>
    </div>

    <div id="search-unavailable" class="hidden">
      <div class="text-center py-12">
        <Icon name="tabler:search-off" class="w-16 h-16 mx-auto text-muted opacity-50" />
        <h2 class="text-xl font-semibold mt-4 mb-2">Search index is being built</h2>
        <p class="text-muted mb-6">
          Pagefind is not supported in local dev mode. The full search is available on the GitHub Pages deployment.
        </p>
        <p class="text-muted text-sm">
          Or you can directly browse
          <a href="/agent-kg-hub/en/articles" class="text-primary hover:underline">all articles</a>
          or
          <a href="/agent-kg-hub/en/category" class="text-primary hover:underline">all categories</a>
          .
        </p>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (async () => {
    try {
      const pagefindModule = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
      await pagefindModule.init();
      window.pagefind = pagefindModule;

      const input = document.getElementById('search-input');
      const results = document.getElementById('search-results');
      const status = document.getElementById('search-status');
      const searchContainer = document.getElementById('search');
      const unavailable = document.getElementById('search-unavailable');

      if (unavailable) unavailable.classList.add('hidden');
      if (searchContainer) searchContainer.classList.remove('hidden');

      let debounceTimer;
      async function performSearch(query) {
        if (!query || query.length < 2) {
          results.innerHTML = '';
          status.classList.add('hidden');
          return;
        }

        const search = await window.pagefind.search(query);
        status.classList.remove('hidden');
        status.textContent = `Found ${search.results.length} result(s)`;

        if (search.results.length === 0) {
          results.innerHTML = `<div class="text-center py-8 text-muted"><p>No results. Try different keywords?</p></div>`;
          return;
        }

        const top = search.results.slice(0, 20);
        const data = await Promise.all(top.map((r) => r.data()));
        results.innerHTML = data
          .map(
            (d) => `
          <article class="p-5 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-primary dark:hover:border-primary transition">
            <a href="${d.url}" class="block">
              <h2 class="text-xl font-bold mb-2 text-slate-900 dark:text-slate-100 hover:text-primary transition">
                ${d.meta?.title || d.title || 'Untitled'}
              </h2>
              <p class="text-muted text-sm mb-2 line-clamp-3">${d.excerpt || ''}</p>
              <div class="flex flex-wrap gap-2 text-xs">
                ${(d.tags || []).slice(0, 3).map((t) => `<span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-800 rounded-full">${t}</span>`).join('')}
                <span class="text-slate-400">${d.url}</span>
              </div>
            </a>
          </article>
        `
          )
          .join('');
      }

      input.addEventListener('input', (e) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => performSearch(e.target.value), 250);
      });

      const params = new URLSearchParams(window.location.search);
      const initialQuery = params.get('q');
      if (initialQuery) {
        input.value = initialQuery;
        performSearch(initialQuery);
      }
    } catch (err) {
      console.warn('Pagefind not available:', err);
      const search = document.getElementById('search');
      const unavailable = document.getElementById('search-unavailable');
      if (search) search.classList.add('hidden');
      if (unavailable) unavailable.classList.remove('hidden');
    }
  })();
</script>

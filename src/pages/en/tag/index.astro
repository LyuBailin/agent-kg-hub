---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';

import { findTags } from '~/utils/blog';
import { fetchEnPosts } from '~/utils/posts-en';

export const prerender = true;

const tags = await findTags(fetchEnPosts());

// 3-tier pill sizing based on article count
const sizeFor = (count: number): string => {
  if (count >= 3) return 'text-base font-semibold px-4 py-2';
  if (count >= 2) return 'text-sm font-medium px-3 py-1.5';
  return 'text-xs px-3 py-1';
};

const metadata = {
  title: 'All Tags',
  description: 'Browse Agent × Knowledge Graph articles by keyword tag.',
};
---

<Layout metadata={metadata}>
  <Hero tagline="Browse">
    <Fragment slot="title">All Tags</Fragment>
    <Fragment slot="subtitle">
      Find the topic you care about by keyword. The more articles, the richer the area.
    </Fragment>
  </Hero>

  <Note title="Note" description="Tags are derived from each article's frontmatter `tags` field — {tags.length} tags in total, aggregated across all English articles." />

  <section class="px-4 md:px-6 py-12 md:py-16 mx-auto max-w-6xl">
    <div class="flex flex-wrap gap-2 md:gap-3 justify-center">
      {
        tags.map((tag) => (
          <a
            href={`/en/tag/${tag.slug}/`}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-gray-700 dark:text-slate-200 hover:bg-primary hover:text-white hover:border-primary dark:hover:bg-blue-700 dark:hover:border-blue-700 transition-colors',
              sizeFor(tag.count),
            ]}
            title={`${tag.title} — ${tag.count} article(s)`}
          >
            <span>{tag.title}</span>
            <span class="text-xs opacity-70">×{tag.count}</span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Note from '~/components/widgets/Note.astro';
import ParadigmMap from '~/components/widgets/ParadigmMap.astro';

const metadata = {
  title: 'Agent × 知识图谱技术资源导航',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: '浏览资源导航',
        href: '/agent-kg-hub/category/',
        icon: 'tabler:compass',
      },
      {
        text: '阅读概念解读',
        href: '/agent-kg-hub/articles/',
        icon: 'tabler:book',
      },
      {
        text: '站内搜索',
        href: '/agent-kg-hub/search',
        icon: 'tabler:search',
      },
    ]}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">LLM Agent</span>
      ×
      <span class="text-accent dark:text-white">知识图谱</span>
      <br />技术资源导航与深度解读
    </Fragment>

    <Fragment slot="subtitle">
      聚焦 Agent 与 KG 交叉领域的<span class="font-semibold">轻量资源聚合 + 关键概念深度解读</span>。
      覆盖三大融合范式:KG 增强 LLM、LLM 增强 KG、LLM 与 KG 协同。
    </Fragment>

    <!-- Hero 装饰:动态知识图谱背景 -->
    <Fragment slot="bg">
      <svg
        class="absolute inset-0 w-full h-full opacity-[0.07] dark:opacity-[0.12]"
        xmlns="http://www.w3.org/2000/svg"
        preserveAspectRatio="xMidYMid slice"
        viewBox="0 0 1200 600"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="hero-line" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#4F46E5"></stop>
            <stop offset="50%" stop-color="#0EA5E9"></stop>
            <stop offset="100%" stop-color="#8B5CF6"></stop>
          </linearGradient>
          <radialGradient id="hero-node-grad">
            <stop offset="0%" stop-color="#4F46E5"></stop>
            <stop offset="100%" stop-color="#0EA5E9"></stop>
          </radialGradient>
        </defs>
        <!-- 节点 -->
        <g fill="url(#hero-node-grad)">
          <circle cx="100" cy="80" r="4"></circle>
          <circle cx="220" cy="150" r="3"></circle>
          <circle cx="350" cy="100" r="5"></circle>
          <circle cx="480" cy="180" r="3"></circle>
          <circle cx="600" cy="120" r="4"></circle>
          <circle cx="720" cy="200" r="3"></circle>
          <circle cx="850" cy="140" r="5"></circle>
          <circle cx="980" cy="220" r="3"></circle>
          <circle cx="1100" cy="160" r="4"></circle>
          <circle cx="150" cy="350" r="5"></circle>
          <circle cx="280" cy="420" r="3"></circle>
          <circle cx="400" cy="380" r="4"></circle>
          <circle cx="530" cy="450" r="3"></circle>
          <circle cx="650" cy="400" r="5"></circle>
          <circle cx="780" cy="480" r="3"></circle>
          <circle cx="900" cy="420" r="4"></circle>
          <circle cx="1020" cy="500" r="3"></circle>
          <circle cx="180" cy="520" r="4"></circle>
          <circle cx="320" cy="560" r="3"></circle>
          <circle cx="460" cy="540" r="5"></circle>
          <circle cx="610" cy="560" r="3"></circle>
          <circle cx="750" cy="520" r="4"></circle>
        </g>
        <!-- 连接线 -->
        <g stroke="url(#hero-line)" stroke-width="1" opacity="0.6">
          <line x1="100" y1="80" x2="220" y2="150"></line>
          <line x1="220" y1="150" x2="350" y2="100"></line>
          <line x1="350" y1="100" x2="480" y2="180"></line>
          <line x1="480" y1="180" x2="600" y2="120"></line>
          <line x1="600" y1="120" x2="720" y2="200"></line>
          <line x1="720" y1="200" x2="850" y2="140"></line>
          <line x1="850" y1="140" x2="980" y2="220"></line>
          <line x1="980" y1="220" x2="1100" y2="160"></line>
          <line x1="150" y1="350" x2="280" y2="420"></line>
          <line x1="280" y1="420" x2="400" y2="380"></line>
          <line x1="400" y1="380" x2="530" y2="450"></line>
          <line x1="530" y1="450" x2="650" y2="400"></line>
          <line x1="650" y1="400" x2="780" y2="480"></line>
          <line x1="780" y1="480" x2="900" y2="420"></line>
          <line x1="900" y1="420" x2="1020" y2="500"></line>
          <line x1="180" y1="520" x2="320" y2="560"></line>
          <line x1="320" y1="560" x2="460" y2="540"></line>
          <line x1="460" y1="540" x2="610" y2="560"></line>
          <line x1="610" y1="560" x2="750" y2="520"></line>
          <line x1="100" y1="80" x2="150" y2="350"></line>
          <line x1="350" y1="100" x2="400" y2="380"></line>
          <line x1="600" y1="120" x2="650" y2="400"></line>
          <line x1="850" y1="140" x2="900" y2="420"></line>
          <line x1="1100" y1="160" x2="1020" y2="500"></line>
          <line x1="220" y1="150" x2="280" y2="420"></line>
          <line x1="480" y1="180" x2="530" y2="450"></line>
          <line x1="720" y1="200" x2="780" y2="480"></line>
        </g>
      </svg>
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="定位" description="不是 awesome list,也不是学术综述 — 是经过筛选的、能直接上手的实战参考。" />

  <!-- ParadigmMap 交互图 -->

  <ParadigmMap />

  <!-- Content Widget: 重点项目 **************** -->

  <Content
    isReversed
    tagline="重点关注"
    title="持续追踪的核心项目"
    items={[
      {
        title: 'Microsoft GraphRAG',
        description: '2024 年 7 月开源的工业级 KG 增强 RAG 方案,提供 Local/Global/DRIFT/Lazy 四种检索模式。',
      },
      {
        title: 'LangGraph (80k+ stars, MIT)',
        description: '用有向图建模 Agent 状态机的代表性框架,支持 Human-in-the-Loop 与 Checkpoint。',
      },
      {
        title: 'HuggingFace smolagents',
        description: '极简 Code Agent 实现(约 1k 行核心代码),让 LLM 直接生成 Python 代码执行动作。',
      },
      {
        title: '字节 DeerFlow 2.0',
        description: '20k+ stars 的长时程 SuperAgent,内置子 Agent 编排、sandbox 隔离、长时程记忆。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1518770660439-4636190af475?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80',
      alt: '知识图谱与 Agent 网络示意',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">不只是清单,而是项目地图</h3>
      通过分类整理 + 原创点评,帮助你快速判断哪些项目值得深入研究。
    </Fragment>
  </Content>

  <!-- Features2 Widget: 仓库提供的服务 ************** -->

  <Features2
    title="这个仓库能给你什么"
    subtitle="围绕 Agent × KG 主题,提供 4 类内容服务"
    tagline="内容架构"
    items={[
      {
        title: '资源导航',
        description:
          '分类整理论文、开源项目、博客、视频教程,每条资源附原创点评,说明"为什么它对 Agent + KG 主题特别重要"。',
        icon: 'tabler:compass',
      },
      {
        title: '概念解读',
        description:
          '对 GraphRAG、ReAct、图智能体(GLA)等核心概念做 1-2 篇文章级别的深度解读,带图解和代码片段。',
        icon: 'tabler:book',
      },
      {
        title: '学习路径',
        description:
          '按难度递进的内容编排,从"什么是 KG"到"如何用 GraphRAG 构建自己的知识增强 Agent"。',
        icon: 'tabler:route',
      },
      {
        title: '生态追踪',
        description:
          '持续更新该领域的新论文、新项目、新工具,保持与前沿同步。每周审核,每月大更。',
        icon: 'tabler:refresh',
      },
    ]}
  />

  <!-- BlogLatestPosts Widget ******* -->

  <BlogLatestPosts
    title="最新概念解读"
    information="持续更新中,先围绕三大融合范式各出 1-2 篇深度文章,后续覆盖特定项目与实战案例。"
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '推荐资源/投稿',
        href: 'https://github.com/LyuBailin/agent-kg-hub/issues',
        target: '_blank',
        icon: 'tabler:message-plus',
      },
      {
        text: '查看 GitHub 仓库',
        href: 'https://github.com/LyuBailin/agent-kg-hub',
        target: '_blank',
        icon: 'tabler:brand-github',
      },
    ]}
  >
    <Fragment slot="title">一起把这个仓库做得更好</Fragment>

    <Fragment slot="subtitle">
      欢迎推荐优秀资源、提交概念解读文章、反馈问题。共建 Agent × KG 中文社区。
    </Fragment>
  </CallToAction>
</Layout>

---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';

import { findTags } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;

const tags = await findTags();

// 根据文章数决定 pill 尺寸,3 级映射
const sizeFor = (count: number): string => {
  if (count >= 3) return 'text-base font-semibold px-4 py-2';
  if (count >= 2) return 'text-sm font-medium px-3 py-1.5';
  return 'text-xs px-3 py-1';
};

const metadata = {
  title: '全部标签',
  description: '按关键词浏览 Agent × 知识图谱的文章标签索引。',
};
---

<Layout metadata={metadata}>
  <Hero tagline="浏览">
    <Fragment slot="title">全部标签</Fragment>
    <Fragment slot="subtitle">
      按关键词快速找到你关心的话题。标签越多说明这个方向内容越丰富。
    </Fragment>
  </Hero>

  <Note title="说明" description="标签来源于每篇文章的 frontmatter `tags` 字段,共 {tags.length} 个标签,聚合自全部文章。" />

  <section class="px-4 md:px-6 py-12 md:py-16 mx-auto max-w-6xl">
    <div class="flex flex-wrap gap-2 md:gap-3 justify-center">
      {
        tags.map((tag) => (
          <a
            href={getPermalink(tag.slug, 'tag')}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-gray-700 dark:text-slate-200 hover:bg-primary hover:text-white hover:border-primary dark:hover:bg-blue-700 dark:hover:border-blue-700 transition-colors',
              sizeFor(tag.count),
            ]}
            title={`${tag.title} — ${tag.count} 篇文章`}
          >
            <span>{tag.title}</span>
            <span class="text-xs opacity-70">×{tag.count}</span>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
